<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark" />
  <title>Sign in – Y-Bot</title>
  <link rel="preload" href="/assets/fonts/saira-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/css/base.css" />
  <link rel="stylesheet" href="/assets/css/components.css" />
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
  <script src="/assets/js/app.js" defer></script>
</head>
<body>
  <main class="auth">
    <div class="auth-card">
      <header class="auth-header">
        <img src="/assets/img/mark.svg" alt="" width="48" height="48" />
        <h1>Sign in to Y-Bot</h1>
        <p>Manage your robots and see what they've been up to.</p>
      </header>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%- h.icon("circle-alert") %><div><%= error %></div></div>
      <% } %>

      <form action="/panel/login" method="post">
        <div class="field">
          <label class="label" for="email">Email address</label>
          <input class="input" id="email" type="email" name="email" value="<%= email %>" autocomplete="username" required <% if (!email) { %>autofocus<% } %> />
        </div>
        <div class="field">
          <label class="label" for="password">Password</label>
          <div class="input-group">
            <input class="input" id="password" type="password" name="password" autocomplete="current-password" required <% if (email) { %>autofocus<% } %> />
            <button class="btn btn-ghost btn-icon" type="button" data-reveal="password" aria-pressed="false" aria-label="Show password"><%- h.icon("eye") %></button>
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary btn-block" type="submit">Sign in</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
