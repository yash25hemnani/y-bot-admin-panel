<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <title>Login - Y-Bot Admin</title>
  <link rel="stylesheet" href="/assets/kapella/vendors/mdi/css/materialdesignicons.min.css" />
  <link rel="stylesheet" href="/assets/kapella/vendors/base/vendor.bundle.base.css" />
  <link rel="stylesheet" href="/assets/kapella/css/style.css" />
  <link rel="stylesheet" href="/assets/kapella/css/custom.css" />
  <link rel="shortcut icon" href="/assets/kapella/images/favicon.png" />
</head>
<body>
  <div class="container-scroller">
    <div class="container-fluid page-body-wrapper full-page-wrapper">
      <div class="main-panel">
        <div class="content-wrapper d-flex align-items-center auth px-0">
          <div class="row w-100 mx-0">
            <div class="col-lg-4 mx-auto">
              <div class="auth-form-light text-left py-5 px-4 px-sm-5">
                <div class="brand-logo">
                  <img src="/assets/kapella/images/logo.svg" alt="Y-Bot Admin" />
                </div>
                <h4>Hello! let's get started</h4>
                <h6 class="font-weight-light">Sign in to continue.</h6>

                <% if (typeof error !== "undefined" && error) { %>
                  <div class="alert alert-danger mt-3" role="alert"><%= error %></div>
                <% } %>

                <form class="pt-3" action="/api/auth/login" method="post" autocomplete="off">
                  <div class="form-group">
                    <input type="email" name="email" class="form-control form-control-lg" placeholder="Email address" required />
                  </div>
                  <div class="form-group">
                    <input type="password" name="password" class="form-control form-control-lg" placeholder="Password" required />
                  </div>
                  <div class="mt-3">
                    <button type="submit" class="btn btn-block btn-primary btn-lg font-weight-medium auth-form-btn">SIGN IN</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script src="/assets/kapella/vendors/base/vendor.bundle.base.js"></script>
  <script src="/assets/kapella/js/template.js"></script>
</body>
</html>
